# Dedicated C8 profile workload aligned to the fixed prefill8k performance point.
# 256 total requests keep the same client load size as the AIPerf benchmark.
# The server profiler still captures its configured first 20 model iterations.
SCENARIO=prefill-8k-c8-256
PROFILE_INPUT_LEN=8192
PROFILE_OUTPUT_LEN=512
PROFILE_NUM_PROMPTS=256
PROFILE_MAX_CONCURRENCY=8
