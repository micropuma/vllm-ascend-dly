# bench-tutorial 统一参数合同（全场景共用）
# 本文件被 run_closed_loop.sh / run_open_loop.sh / run_smoke.sh / analyze.py / baseline/server.sh 读取，
# 保证各场景口径一致。改动请同步 task-10-17.md §4 决策表。

# ---- 服务端（MTP3 基线，端口 8077）----
SERVER_URL="http://127.0.0.1:8077"
MODEL="glm"
MODEL_PATH="/data/weight/GLM-5.3-Flash-w8a8-v2"
TOKENIZER="/data/weight/GLM-5.3-Flash-w8a8-v2"

# ---- 并发参数旋钮（A/B 轴正交实验唯一要改的两项；实验结束恢复 32/8192）----
# baseline/server.sh 启动时读取；改完需重启服务生效。
MAX_NUM_SEQS="32"
MAX_NUM_BATCHED_TOKENS="8192"

# ---- AIPerf 客户端（独立 venv，写死绝对路径，不 activate）----
AIPERF="/workspace/aiperf-venv/bin/aiperf"

# ---- 压测口径（对齐 950）----
INPUT_LENS="8192 32768"          # 8K / 32K
OUTPUT_LEN="512"                 # 固定输出，保证 μ=output_token_throughput÷512 成立
EXTRA_INPUTS="ignore_eos:true"   # 强制固定输出（等价 vllm bench --ignore-eos）
RANDOM_RANGE_RATIO="0"           # 输入/输出长度不抖动（vllm 语义）
SEED="1024"
ENDPOINT_TYPE="chat"             # OpenAI chat completions
STREAMING="true"                 # 必须开，否则无 TTFT/ITL 指标
ARRIVAL_PATTERN="poisson"        # 开环到达分布

# ---- 闭环 ----
CONCURRENCIES="1 8 16 32"        # 扫并发布点
CLOSED_REQUEST_COUNT="256"       # 每并发档请求数（n≥200，±7%）

# ---- 开环 ----
OPEN_REQUEST_COUNT="256"         # 每到达率档请求数（n≥200，±7%）
# RATES 由 μ_max 分档反推（0.45/0.70/0.85/1.20 × μ_max(isl)），
# 由 `analyze.py --emit-rates` 生成 out/<RUN_ID>/rates.txt，run_open_loop.sh 分档读取

# ---- SLO（v0，依据本机 xieyu-workload-reproduction-v1 + 950 同档实测）----
# TTFT P95: 8K≤3.0s / 16K≤5.0s / 32K≤8.0s；ITL P99≤1.0s（关注项）；达成率≥95%
SLO_TTFT_P95_8K="3.0"
SLO_TTFT_P95_32K="8.0"
SLO_ITL_P99="1.0"
SLO_ACHIEVE_RATE="0.95"
